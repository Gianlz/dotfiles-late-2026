[user]
	name = Gianlz
	email = gianlucazugnoifc@gmail.com
	signingkey = /home/razorbill/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[core]
	editor = nvim
	autocrlf = input
	excludesfile = /home/razorbill/.gitignore_global
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
